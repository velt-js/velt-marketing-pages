# ---------------------------------------------------------------------------
# Amplitude (analytics + Session Replay)
# ---------------------------------------------------------------------------
# These are NEXT_PUBLIC_* so Next.js inlines them into the client bundle at
# BUILD time. That means they must be set in the environment that runs
# `next build` (your deploy/CI), not just at runtime.
#
# Amplitude is only initialized on production-like builds (`next build` /
# `next start`). Local `next dev` skips it entirely, so leaving these blank
# locally is fine and intentional.

# Amplitude Browser SDK key — Amplitude → Settings → Projects → your project.
# Browser keys are client-side by design (they ship in the bundle). Leave
# blank to disable Amplitude (init no-ops when the key is missing).
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# 0–1 fraction of sessions to record with Session Replay. 1 = record every
# session, 0 = disable Session Replay entirely. Defaults to 1 when unset.
NEXT_PUBLIC_AMPLITUDE_SESSION_REPLAY_SAMPLE_RATE=1

# Optional: only set these if you run a reverse proxy in front of Amplitude's
# ingestion endpoints (common to dodge ad blockers that block amplitude.com/*
# domains). Leave blank to use Amplitude's default endpoints.
NEXT_PUBLIC_AMPLITUDE_EVENT_PROXY_URL=
NEXT_PUBLIC_AMPLITUDE_SESSION_REPLAY_TRACK_PROXY_URL=
NEXT_PUBLIC_AMPLITUDE_SESSION_REPLAY_CONFIG_PROXY_URL=
