{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://velt.mintlify.dev/docs"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://velt.mintlify.dev/docs/:path*"
    },
    {
      "source": "/_mintlify/:path*",
      "destination": "https://velt.mintlify.dev/_mintlify/:path*"
    },
    {
      "source": "/mintlify-assets/:path*",
      "destination": "https://velt.mintlify.dev/mintlify-assets/:path*"
    },
    {
      "source": "/api/request",
      "destination": "https://velt.mintlify.dev/_mintlify/api/request"
    }
  ]
}
